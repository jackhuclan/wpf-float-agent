<Project>

  <!--
    全解决方案共享的工程元数据（Directory.Build.props 会被目录树下所有 .csproj 自动导入）。
    发布 / 升级版本时只改这一处：Version 会同时作用到程序集版本与 NuGet 包版本。
  -->
  <PropertyGroup>

    <!-- 版本：语义化版本，同时作为 AssemblyVersion / FileVersion / NuGet 包版本 -->
    <Version>1.3.1</Version>
    <VersionPrefix Condition="'$(VersionSuffix)' != ''">$(Version)</VersionPrefix>

    <!-- 作者与公司 -->
    <Authors>jackhuclan</Authors>
    <Company>jackhuclan</Company>

    <!-- 产品与描述 -->
    <Product>Floaticon</Product>
    <Description>
      Floaticon：常驻 Windows 桌面右下角的轻量 AI 助手悬浮球。
      基于 Microsoft Agent Framework（MAF）+ WPF：点击悬浮球弹出流式对话窗，
      内置 Markdown 渲染、Token 统计、可扩展的技能（Skills）与工具（Tools）体系，
      模型供应商可配置；支持 Linux 容器内执行 C# / Python / JavaScript 代码。
    </Description>

    <!-- 项目地址 -->
    <PackageProjectUrl>https://github.com/jackhuclan/wpf-float-agent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jackhuclan/wpf-float-agent.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- 版权与许可证 -->
    <Copyright>Copyright © 2026 jackhuclan</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- NuGet 打包通用设置 -->
    <PackageTags>ai;agent;wpf;floating-assistant;dotnet;python;container</PackageTags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- 编译信息注入程序集（FileVersion / InformationalVersion 显示于文件属性） -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>

  </PropertyGroup>

</Project>
