<UserControl x:Class="Floaticon.Views.WriteConfirmationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 写操作确认卡：write_file 等工具写入前请求人工放行。
         DataContext 为 ConfirmationCardViewModel，同意/拒绝命令直接绑定自身。 -->
    <Border CornerRadius="12,12,12,4"
            Background="#FFFBEB"
            BorderBrush="#F59E0B"
            BorderThickness="1"
            Padding="12,10">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#92400E" />
            <TextBlock Text="{Binding TargetPath, StringFormat=目标：{0}}"
                       FontSize="11"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />

            <!-- 将写入内容的预览（等宽字体，超长滚动） -->
            <Border Background="#FFFFFF"
                    BorderBrush="#FDE68A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,6"
                    Margin="0,8,0,0"
                    MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Preview}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="#374151"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- 同意 / 拒绝：决定后按钮整行隐藏，露出结果文本 -->
            <StackPanel x:Name="ConfirmButtons"
                        Orientation="Horizontal"
                        Margin="0,10,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPending}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Command="{Binding ApproveCommand}"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ApproveBg" CornerRadius="6" Background="#16A34A" Padding="14,5">
                                <TextBlock Text="同意写入" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ApproveBg" Property="Background" Value="#15803D" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Command="{Binding DenyCommand}"
                        Margin="8,0,0,0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="DenyBg" CornerRadius="6" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" Padding="14,5">
                                <TextBlock Text="拒绝" FontSize="12" Foreground="#374151" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DenyBg" Property="Background" Value="#F3F4F6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <TextBlock x:Name="ConfirmOutcome"
                       Text="{Binding Outcome}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#92400E"
                       Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPending}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
