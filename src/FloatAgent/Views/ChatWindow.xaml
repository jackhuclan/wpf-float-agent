<Window x:Class="Floaticon.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
        xmlns:behaviors="clr-namespace:Floaticon.Views.Behaviors"
        Title="AI 助手"
        Width="456" Height="811"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Markdown 渲染样式：基于 MdXaml 内置 Compact（12px 正文、紧凑标题），字体换成雅黑 -->
        <Style x:Key="MdCompactStyle"
               TargetType="FlowDocument"
               BasedOn="{x:Static mdxam:MarkdownStyle.Compact}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>

        <!-- 细窄滚动条（显式套用到自定义 ScrollViewer 模板中） -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBar"
                                                        Background="#C9CEE0"
                                                        CornerRadius="3"
                                                        Margin="1,2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Background" Value="#A9B0C8" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBar" Property="Background" Value="#8E96B3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 消息区 ScrollViewer 模板：内容列 + 细窄纵向滚动条（结构对齐默认模板，保证拖拽/滚轮可用） -->
        <Style x:Key="ThinScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar Grid.Column="1"
                                       x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical"
                                       Style="{StaticResource ThinScrollBar}"
                                       Cursor="Arrow"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 消息气泡模板 -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- AI 侧：气泡 + 工具栏（靠左，白色） -->
                <StackPanel x:Name="AiPanel"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            MaxWidth="350"
                            Margin="0,0,40,0"
                            Visibility="Collapsed">

                    <Border MaxWidth="320"
                            CornerRadius="12,12,12,4"
                            Background="#FFFFFF"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="10,7">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制" Command="{Binding CopyCommand}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <!-- MdXaml 渲染 Markdown 回复（Compact 紧凑排版） -->
                        <mdxam:MarkdownScrollViewer Markdown="{Binding Text}"
                                                    MarkdownStyle="{StaticResource MdCompactStyle}"
                                                    Background="Transparent"
                                                    Padding="0"
                                                    VerticalScrollBarVisibility="Disabled"
                                                    HorizontalScrollBarVisibility="Disabled" />
                    </Border>

                    <!-- 回复工具栏：复制 / token 用量 / 模型 -->
                    <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                        <Button Command="{Binding CopyCommand}"
                                ToolTip="复制"
                                Cursor="Hand"
                                Width="24" Height="18">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CopyBg" CornerRadius="4" Background="Transparent">
                                        <Grid Width="13" Height="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                                                       Stroke="#8A94A6" StrokeThickness="1.2"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                                                       Stroke="#8A94A6" StrokeThickness="1.2"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CopyBg" Property="Background" Value="#E5E7EB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- token 用量 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}">
                            <Path Width="12" Height="12"
                                  Data="M 6,1.5 L 10.5,6 L 6,10.5 L 1.5,6 Z"
                                  Stroke="#8A94A6" StrokeThickness="1.2"
                                  Stretch="None" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UsageText}"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </StackPanel>

                        <!-- 模型名 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}">
                            <Path Width="12" Height="12"
                                  Data="M 6.5,1 L 2.5,7 H 5.5 L 5,11 L 9.5,5 H 6.5 Z"
                                  Fill="#8A94A6"
                                  Stretch="None" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ModelText}"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 正在输入占位（靠左，三个点） -->
                <Border x:Name="TypingBubble"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        CornerRadius="12,12,12,4"
                        Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,40,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Height="10">
                            <Ellipse Width="7" Height="7" Fill="#9CA3AF" Margin="0,0,4,0" />
                            <Ellipse Width="7" Height="7" Fill="#9CA3AF" Margin="0,0,4,0" />
                            <Ellipse Width="7" Height="7" Fill="#9CA3AF" />
                        </StackPanel>
                        <!-- 工具执行进度等附加状态（无状态时不占位） -->
                        <TextBlock x:Name="TypingStatus"
                                   Text="{Binding Status}"
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   TextWrapping="Wrap"
                                   MaxWidth="320"
                                   Margin="0,7,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 用户气泡（靠右，蓝色）+ 悬浮时在下方露出的复制按钮 -->
                <StackPanel x:Name="UserPanel"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            MaxWidth="320"
                            Margin="40,0,0,0"
                            Visibility="Collapsed">
                    <Border x:Name="UserBubble"
                            CornerRadius="12,12,4,12"
                            Background="#4F6BF5"
                            Padding="12,8">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制" Command="{Binding CopyCommand}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <TextBlock Text="{Binding Text}"
                                   FontSize="13"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- 操作行（时间 + 复制按钮）：默认隐藏，鼠标进入整个用户消息区域时显示，靠右对齐。
                         整行位于外层 StackPanel 内部，从气泡移向按钮的过程中 IsMouseOver 不会中断，
                         因此不会出现"一动鼠标就消失"的抖动。 -->
                    <StackPanel x:Name="UserActions"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,4,2,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=UserPanel}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- 时间：今天显示 11:25，跨天显示 10月24日 09:50 -->
                        <TextBlock x:Name="UserTimeLabel"
                                   Text="{Binding TimeText}"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />

                        <Button x:Name="UserCopyButton"
                                Command="{Binding CopyCommand}"
                                ToolTip="复制"
                                Cursor="Hand"
                                Width="24" Height="14"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CopyBg" CornerRadius="4" Background="Transparent">
                                        <Grid Width="13" Height="13"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                                                       Stroke="#8A94A6" StrokeThickness="1.2"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                                                       Stroke="#8A94A6" StrokeThickness="1.2"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CopyBg" Property="Background" Value="#E5E7EB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="UserPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsUser}" Value="False" />
                        <Condition Binding="{Binding IsTyping}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="AiPanel" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsUser}" Value="False" />
                        <Condition Binding="{Binding IsTyping}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TypingBubble" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外层留白给阴影 -->
    <Grid Margin="20">
        <Border CornerRadius="16"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1F2937" BlurRadius="28" ShadowDepth="6" Opacity="0.28" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 自绘标题栏（可拖动窗口） -->
                <Border Grid.Row="0"
                        Background="#6366F1"
                        CornerRadius="16,16,0,0"
                        Padding="16,12"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <!-- 小图标：迷你球 -->
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A5B4FC" Offset="0" />
                                        <GradientStop Color="#E9D5FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="AI 助手"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <!-- 配置按钮 -->
                            <Button Content="⚙"
                                    Width="28" Height="28"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#E0E7FF"
                                    FontSize="14"
                                    Cursor="Hand"
                                    ToolTip="模型配置"
                                    Click="OnConfigClick" />

                            <!-- 关闭按钮 -->
                            <Button Content="✕"
                                    Width="28" Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#E0E7FF"
                                    FontSize="12"
                                    Cursor="Hand"
                                    ToolTip="收起"
                                    Click="OnCloseClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 消息列表（细窄滚动条 + 像素滚动 + 滚轮缓动） -->
                <ScrollViewer Grid.Row="1"
                              x:Name="MessagesScroll"
                              Style="{StaticResource ThinScrollViewerStyle}"
                              CanContentScroll="False"
                              VerticalScrollBarVisibility="Auto"
                              behaviors:SmoothScrollBehavior.IsEnabled="True"
                              Margin="0,8,4,0">
                    <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource MessageTemplate}" />
                </ScrollViewer>

                <!-- 输入区 -->
                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        Padding="12,10"
                        CornerRadius="0,0,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 输入框：Border 负责圆角边框；Enter 发送、Shift+Enter 换行 -->
                        <Border Grid.Column="0"
                                CornerRadius="8"
                                Background="#FFFFFF"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Bottom">
                            <TextBox x:Name="InputBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False"
                                     TextWrapping="Wrap"
                                     MinHeight="34"
                                     MaxHeight="96"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="10,7"
                                     KeyDown="OnInputKeyDown" />
                        </Border>

                        <!-- 发送 / 停止：同一位置的圆形图标按钮，随 IsBusy 切换 -->
                        <Grid Grid.Column="1" Width="38" Height="38" VerticalAlignment="Bottom">
                            <!-- 停止（生成中可见） -->
                            <Button Command="{Binding StopCommand}"
                                    ToolTip="停止生成"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Ellipse x:Name="Circle" Fill="#6366F1" />
                                            <Rectangle Width="12" Height="12"
                                                       RadiusX="3" RadiusY="3"
                                                       Fill="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Circle" Property="Fill" Value="#7C7DF3" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Circle" Property="Fill" Value="#4F52D9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 发送（空闲时可见） -->
                            <Button Command="{Binding SendCommand}"
                                    ToolTip="发送（Enter）"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Ellipse x:Name="Circle" Fill="#6366F1" />
                                            <!-- 白色箭头：固定 24x24 设计坐标系并显式居中 -->
                                            <Path Fill="#FFFFFF"
                                                  Width="24" Height="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 12,5.4 L 18.8,18.6 L 12,15.2 L 5.2,18.6 Z" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Circle" Property="Fill" Value="#7C7DF3" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Circle" Property="Fill" Value="#4F52D9" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
