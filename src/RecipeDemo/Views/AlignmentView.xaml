<UserControl x:Class="RecipeDemo.Views.AlignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 主操作按钮（蓝底白字，与 Create Wafer Map 同风格） -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2569E8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D5BD6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#174CA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 箭头（chevron）形 TabItem：选中蓝色，未选灰色 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="-6,0,0,0" Height="30" Width="150">
                            <Path x:Name="TabShape" Stretch="Fill"
                                  Data="M0,0 H132 L148,15 L132,30 H0 L16,15 Z"
                                  Fill="#9CA0A6" />
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="12,0,18,0"
                                              TextElement.FontSize="13"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="White" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabShape" Property="Fill" Value="#2569E8" />
                                <Setter Property="Panel.ZIndex" Value="2" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabShape" Property="Fill" Value="#8A8E94" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="20,16">
        <!-- 右下角 Save -->
        <Button DockPanel.Dock="Bottom"
                Content="Save"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                Margin="0,12,0,0" />

        <StackPanel>
            <TabControl Background="Transparent"
                        BorderThickness="0"
                        Margin="6,0,0,0"
                        Padding="0"
                        SelectedIndex="{Binding SelectedSubTabIndex, Mode=TwoWay}">
                <!-- Edge Alignment：Caculate -->
                <TabItem Header="Edge Alignment">
                    <StackPanel Margin="16,14">
                        <Button Content="Caculate"
                                Command="{Binding CaculateCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" />
                        <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="4" MinHeight="140" Margin="0,12,0,0">
                            <TextBlock Text="Edge 检测结果区域（demo 占位）"
                                       Foreground="#B0B6BF"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Coarse Alignment：Create Template / Run -->
                <TabItem Header="Coarse Alignment">
                    <StackPanel Margin="16,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create Template"
                                    Command="{Binding CreateCoarseTemplateCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Content="Run"
                                    Command="{Binding RunCoarseCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                        <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="4" MinHeight="140" Margin="0,12,0,0">
                            <TextBlock Text="Coarse 模板 / 匹配结果区域（demo 占位）"
                                       Foreground="#B0B6BF"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- Fine Alignment：Create Template / Run -->
                <TabItem Header="Fine Alignment">
                    <StackPanel Margin="16,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Create Template"
                                    Command="{Binding CreateFineTemplateCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Content="Run"
                                    Command="{Binding RunFineCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                        <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="4" MinHeight="140" Margin="0,12,0,0">
                            <TextBlock Text="Fine 模板 / 匹配结果区域（demo 占位）"
                                       Foreground="#B0B6BF"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- 操作反馈 -->
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="6,12,0,0">
                <TextBlock Text="{Binding Log}"
                           FontSize="12"
                           Foreground="#5B6472"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
