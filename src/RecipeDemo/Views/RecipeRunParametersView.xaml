<UserControl x:Class="RecipeDemo.Views.RecipeRunParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="配方运行参数（Recipe-Run Parameters）" FontSize="14" FontWeight="SemiBold" Foreground="#2B2F36" />

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="6" Padding="4,2" Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="380">
                <ItemsControl ItemsSource="{Binding Parameters}" Margin="6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F1F2F4" BorderThickness="0,0,0,1" Padding="4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontSize="12" Foreground="#8A94A6" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2B2F36" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
