<UserControl x:Class="RecipeDemo.Views.WaferMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <!-- 初始状态只有一个 Create Wafer Map 按钮 -->
            <Button Command="{Binding CreateWaferMapCommand}"
                    Content="Create Wafer Map"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#2569E8"
                    BorderThickness="0"
                    Padding="16,8"
                    Cursor="Hand"
                    HorizontalAlignment="Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D5BD6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#174CA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 点击按钮后展示晶圆图 -->
            <StackPanel Visibility="{Binding IsMapVisible, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="300" Height="300" VerticalAlignment="Top">
                        <!-- 晶圆本体 -->
                        <Ellipse Canvas.Left="20" Canvas.Top="20"
                                 Width="260" Height="260"
                                 Fill="#F8FAFC" Stroke="#94A3B8" StrokeThickness="1.5" />
                        <!-- 缺口（notch） -->
                        <Polygon Points="140,279 160,279 150,292"
                                 Fill="#F8FAFC" Stroke="#94A3B8" StrokeThickness="1" />
                        <!-- 圆形裁剪区域内的 die 阵列（示意） -->
                        <Canvas Clip="M150,24 a126,126 0 1 0 0.01,0 z">
                            <UniformGrid Canvas.Left="36" Canvas.Top="36"
                                         Width="228" Height="228"
                                         Rows="6" Columns="6">
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#F87171" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#F87171" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                                <Border Background="#CBD5E1" Margin="1" />
                                <Border Background="#60A5FA" Margin="1" />
                            </UniformGrid>
                        </Canvas>
                    </Canvas>

                    <!-- 图例 -->
                    <StackPanel Margin="20,8,0,0" VerticalAlignment="Top">
                        <TextBlock Text="图例" FontSize="12" Foreground="#8A94A6" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#60A5FA" />
                            <TextBlock Text="Measured" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#F87171" />
                            <TextBlock Text="Defect" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="#CBD5E1" />
                            <TextBlock Text="Unmeasured" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
