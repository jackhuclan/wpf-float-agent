<UserControl x:Class="RecipeDemo.Views.TestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A94A6" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#2B2F36" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16">
            <TextBlock Text="测试项（Tests）" FontSize="14" FontWeight="SemiBold" Foreground="#2B2F36" />

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="6" Padding="4,2" Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="420">
                <StackPanel>
                    <!-- 表头 -->
                    <Grid Margin="10,6,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource HeaderCell}" Text="名称" />
                        <TextBlock Grid.Column="1" Style="{StaticResource HeaderCell}" Text="结果" />
                        <TextBlock Grid.Column="2" Style="{StaticResource HeaderCell}" Text="耗时" />
                    </Grid>
                    <Separator Background="#F1F2F4" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,7,10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Result}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Result}" Value="Fail">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Result}" Value="Pending">
                                                        <Setter Property="Foreground" Value="#9CA3AF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Duration}" Foreground="#6B7280" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
