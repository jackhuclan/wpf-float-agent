<Window x:Class="Floaticon.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型配置"
        Width="440" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 输入框外框：校验失败时变红 -->
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>

        <Style x:Key="FieldTextStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <Style x:Key="RequiredHintStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="该项必填，请输入" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="Margin" Value="2,4,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- 下拉项：圆角高亮，替换默认系统样式 -->
        <Style x:Key="ModelItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="6"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E0E7FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 模型下拉框：外观与其它输入框统一（圆角/灰边/错误时变红） -->
        <Style x:Key="ModelComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModelItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="FieldBorder"
                                                CornerRadius="8"
                                                Background="#FFFFFF"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="10,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />

                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4.5,4.5 L 9,0"
                                                      Stroke="#6B7280"
                                                      StrokeThickness="1.5"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#9CA3AF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#FFFFFF"
                                        CornerRadius="8"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1F2937" BlurRadius="16" ShadowDepth="3" Opacity="0.18" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="190">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border CornerRadius="16"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1F2937" BlurRadius="28" ShadowDepth="6" Opacity="0.28" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0"
                        Background="#6366F1"
                        CornerRadius="16,16,0,0"
                        Padding="16,12"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="模型配置"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center" />
                        <Button Content="✕"
                                Width="28" Height="28"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#E0E7FF"
                                FontSize="12"
                                Cursor="Hand"
                                Click="OnCancelClick" />
                    </Grid>
                </Border>

                <!-- 表单 -->
                <StackPanel Grid.Row="1" Margin="18,18,18,8">
                    <TextBlock Text="填写模型接入信息，三项均为必填。保存后立即生效。"
                               FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <!-- API Key -->
                    <TextBlock Text="API Key" Style="{StaticResource FieldLabelStyle}" />
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource FieldBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ApiKeyError}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextStyle}" />
                    </Border>
                    <TextBlock Style="{StaticResource RequiredHintStyle}"
                               Visibility="{Binding ApiKeyError, Converter={StaticResource BoolToVis}}" />

                    <!-- 模型（下拉选择） -->
                    <TextBlock Text="模型" Style="{StaticResource FieldLabelStyle}" Margin="2,14,0,6" />
                    <ComboBox ItemsSource="{Binding ModelOptions}"
                              SelectedItem="{Binding Model, Mode=TwoWay}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ModelComboBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelError}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Style="{StaticResource RequiredHintStyle}"
                               Visibility="{Binding ModelError, Converter={StaticResource BoolToVis}}" />

                    <!-- 接口地址 -->
                    <TextBlock Text="接口地址" Style="{StaticResource FieldLabelStyle}" Margin="2,14,0,6" />
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource FieldBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EndpointError}" Value="True">
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldTextStyle}" />
                    </Border>
                    <TextBlock Style="{StaticResource RequiredHintStyle}"
                               Visibility="{Binding EndpointError, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="示例：API Key = sk-xxx，模型从下拉框中选择，接口地址 = https://api.deepseek.com/v1"
                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"
                               Margin="2,14,0,0" />

                    <!-- 结果行：失败红色 / 成功绿色 -->
                    <TextBlock Text="{Binding ResultText}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="2,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#EF4444" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="#16A34A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 底部按钮 -->
                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16"
                        Padding="14,10">
                    <Grid>
                        <TextBlock Text="{Binding ConfigPath}"
                                   FontSize="10" Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="2,0,110,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- 测试连接 -->
                            <Button Width="88" Height="32"
                                    Margin="0,0,8,0"
                                    Background="#EEF2FF"
                                    Foreground="#4F46E5"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Cursor="Hand"
                                    ToolTip="用当前填写的配置发一次真实请求，验证能否连通"
                                    Command="{Binding TestConnectionCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="测试连接" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                <Setter Property="Content" Value="测试中…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TestBorder" CornerRadius="8"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TestBorder" Property="Background" Value="#E0E7FF" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="TestBorder" Property="Background" Value="#F3F4F6" />
                                                <Setter Property="Foreground" Value="#9CA3AF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="取消"
                                    Width="64" Height="32"
                                    Margin="0,0,8,0"
                                    Background="#F3F4F6"
                                    Foreground="#4B5563"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Click="OnCancelClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CancelBorder" CornerRadius="8"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CancelBorder" Property="Background" Value="#E5E7EB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="保存"
                                    Width="72" Height="32"
                                    Background="#4F6BF5"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Command="{Binding SaveCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SaveBorder" CornerRadius="8"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SaveBorder" Property="Background" Value="#3F55D8" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="SaveBorder" Property="Background" Value="#3446B8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
